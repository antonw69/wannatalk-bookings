<script>
const $=id=>document.getElementById(id),days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
let authRole=null,mode='login',session=null,selectedLocation='',selectedProvider=null,selectedTime=null,calendarViewDate='';
const key='wannatalkAdminLayoutPrototypeV1';
const brandLogoTransparentData='data:image/png;base64,';
const welcomeBackgroundData='data:image/jpeg;base64,';
const brandLogoData='data:image/png;base64,';
function seedAvailability(){let a={};for(let i=0;i<7;i++)a[i]={on:i>=1&&i<=5,start:'09:00',end:'17:00'};return a}
let data=JSON.parse(localStorage.getItem(key)||'null')||{admins:[{id:501,name:'Practice Admin',email:'admin@wannatalk.co.za'}],providers:[{id:1,name:'Louw Alberts',role:'Counsellor',email:'louw@wannatalk.co.za',mobile:'+27 82 555 0101',duration:'60',bio:'Individual, couples and family counselling.',availability:seedAvailability()},{id:2,name:'Dr Naledi Mokoena',role:'Psychologist',email:'naledi@wannatalk.co.za',mobile:'+27 82 555 0102',duration:'60',bio:'Psychological assessment and individual therapy.',availability:seedAvailability()}],patients:[{id:101,name:'Sarah Jacobs',email:'sarah@test.co.za',mobile:'+27 82 123 4567',contact:'WhatsApp'}],appointments:[]};
if(!data.admins)data.admins=[{id:501,name:'Practice Admin',email:'admin@wannatalk.co.za'}];
