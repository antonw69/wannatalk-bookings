data.providers.forEach((p,i)=>{if(!p.locations)p.locations=i===0?['Centurion','Online']:['Emalahleni','Online']});
if(!data.appointments.length){let today=new Date();let y=today.getFullYear(),m=String(today.getMonth()+1).padStart(2,'0'),d=String(today.getDate()).padStart(2,'0'),ds=`${y}-${m}-${d}`;data.appointments=[{id:9001,providerId:1,patientId:101,date:ds,time:'09:00',duration:60,type:'Individual counselling',mode:'In-person',status:'Confirmed',payment:'Unpaid',note:''}]}
function persist(){localStorage.setItem(key,JSON.stringify(data))}function toast(t){$('toast').textContent=t;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),2200)}
function initials(n){return n.split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase()}function fmtDate(s){return new Date(s+'T00:00:00').toLocaleDateString('en-ZA',{day:'2-digit',month:'short',year:'numeric'})}function todayStr(){let d=new Date();return d.toISOString().slice(0,10)}
function waSvg(){return '<svg class="wa-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4a10.6 10.6 0 1 1 9.3 5zm5.8-8c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.8.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-2-.8-3.4-1.8-4.5-3.8-.3-.5.3-.5.9-1.6.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.6-.5-.8-.5h-.7c-.2 0-.6.1-.9.4-1 1-1.4 2.2-1.4 3.6 0 2.1 1.5 4.1 1.7 4.4.2.3 3 4.7 7.4 6.4 2.7 1.1 3.8 1.2 5.1.9 1.2-.2 1.9-1 2.2-1.9.3-.9.3-1.6.2-1.8-.1-.2-.3-.3-.6-.5z"/></svg>'}
function waNumber(n){return String(n||'').replace(/\D/g,'').replace(/^0/,'27')}
function openWhatsApp(number,message){if(!waNumber(number))return toast('No WhatsApp number saved');window.open(`https://wa.me/${waNumber(number)}?text=${encodeURIComponent(message)}`,'_blank','noopener')}
function appointmentMessage(a,kind){let p=data.providers.find(x=>x.id===a.providerId),pt=data.patients.find(x=>x.id===a.patientId),place=a.location||a.mode,base=`Hi ${pt?.name||'there'}, your ${a.type.toLowerCase()} appointment with ${p?.name||'your WannaTalk provider'} is`;if(kind==='reminder')return `Hi ${pt?.name||'there'}, this is a reminder of your WannaTalk appointment with ${p?.name||'your provider'} on ${fmtDate(a.date)} at ${a.time} (${place}). Please reply to confirm.`;if(kind==='cancelled')return `${base} cancelled for ${fmtDate(a.date)} at ${a.time} (${place}). Please contact us if you would like to reschedule.`;return `${base} ${a.status.toLowerCase()} for ${fmtDate(a.date)} at ${a.time} (${place}). Reply here if you need any assistance.`}
function queueMessage(a,kind,recipient='patient'){let target=recipient==='patient'?data.patients.find(x=>x.id===a.patientId):data.providers.find(x=>x.id===a.providerId),text=recipient==='patient'?appointmentMessage(a,kind):`New WannaTalk update: ${data.patients.find(x=>x.id===a.patientId)?.name||'A patient'} ${kind==='cancelled'?'cancelled':'booked'} ${fmtDate(a.date)} at ${a.time} (${a.location||a.mode}).${a.intakeRequested?' The patient selected the optional intake form.':''}`;data.messages.unshift({id:Date.now()+Math.random(),appointmentId:a.id,providerId:a.providerId,recipient,name:target?.name||'Contact',number:target?.mobile||'',kind,text,createdAt:new Date().toISOString(),sent:false});return data.messages[0]}
function chooseRole(r){authRole=r;$('roleChoice').classList.add('hidden');$('authArea').classList.remove('hidden');$('authHeading').textContent=r==='patient'?'Patient access':r==='provider'?'Provider access':'Administrator access';$('registerTab').classList.toggle('hidden',r==='admin');switchMode('login');$('demoCreds').textContent='Use your secure WannaTalk account password.';buildRegister()}
