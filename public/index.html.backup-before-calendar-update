function buildRegister(){$('regFields').innerHTML=`<div class="field"><label>Full name</label><input id="rName"></div><div class="field"><label>Email</label><input id="rEmail" type="email"></div><div class="field"><label>Mobile</label><input id="rMobile"></div>${authRole==='provider'?'<div class="field"><label>Professional title</label><input id="rRole" placeholder="Counsellor / Psychologist"></div><div class="field"><label>Default session duration</label><select id="rDuration"><option value="45">45 minutes</option><option value="60" selected>60 minutes</option><option value="90">90 minutes</option></select></div>':''}<div class="field"><label>Password</label><input id="rPassword" type="password"></div>`}
function doLogin(){let list=authRole==='patient'?data.patients:authRole==='provider'?data.providers:data.admins;let u=list.find(x=>x.email.toLowerCase()===$('loginEmail').value.trim().toLowerCase()&&x.password===$('loginPassword').value);if(!u)return toast('Incorrect login details');session={role:authRole,id:u.id};openSession()}
function doRegister(){let email=$('rEmail').value.trim(),name=$('rName').value.trim(),pw=$('rPassword').value;if(!email||!name||!pw)return toast('Name, email and password are required');if([...data.patients,...data.providers].some(x=>x.email.toLowerCase()===email.toLowerCase()))return toast('That email is already registered');if(authRole==='patient'){let u={id:Date.now(),name,email,mobile:$('rMobile').value.trim(),password:pw,contact:'WhatsApp'};data.patients.push(u);session={role:'patient',id:u.id}}else{let u={id:Date.now(),name,email,mobile:$('rMobile').value.trim(),password:pw,role:$('rRole').value.trim()||'Provider',duration:$('rDuration').value,bio:'',availability:seedAvailability()};data.providers.push(u);session={role:'provider',id:u.id}}persist();openSession()}
function openSession(){$('auth').classList.add('hidden');$('providerShell').classList.add('hidden');$('patientShell').classList.add('hidden');$('adminShell').classList.add('hidden');if(session.role==='provider'){$('providerShell').classList.remove('hidden');renderProvider()}else if(session.role==='admin'){$('adminShell').classList.remove('hidden');renderAdmin()}else{$('patientShell').classList.remove('hidden');renderPatient()}}
function logout(){session=null;selectedProvider=null;selectedTime=null;$('providerShell').classList.add('hidden');$('patientShell').classList.add('hidden');$('adminShell').classList.add('hidden');$('auth').classList.remove('hidden');backRole()}
function currentProvider(){return data.providers.find(x=>x.id===session.id)}function currentPatient(){return data.patients.find(x=>x.id===session.id)}
document.querySelectorAll('[data-pview]').forEach(b=>b.onclick=()=>showP(b.dataset.pview,b));document.querySelectorAll('[data-uview]').forEach(b=>b.onclick=()=>showU(b.dataset.uview,b));document.querySelectorAll('[data-aview]').forEach(b=>b.onclick=()=>showA(b.dataset.aview,b));
