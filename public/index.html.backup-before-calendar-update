async function apiRequest(path,options={}){
  let headers={...(options.headers||{})};
  if(options.body&&!headers['Content-Type'])headers['Content-Type']='application/json';
  if(apiToken)headers.Authorization=`Bearer ${apiToken}`;
  let response=await fetch(`${apiBase}${path}`,{...options,headers});
  let payload=response.status===204?null:await response.json().catch(()=>({}));
  if(!response.ok){
    if(response.status===401){apiToken='';localStorage.removeItem(apiTokenKey)}
    throw new Error(payload?.error||`Request failed (${response.status})`);
  }
  return payload;
}

function apiTime(value){return String(value||'').slice(0,5)}
function apiDate(value){return String(value||'').slice(0,10)}
function availabilityFromApi(rows){
  let result={};
  for(let day=0;day<7;day++)result[day]={on:false,start:'09:00',end:'17:00'};
  rows.forEach(row=>{result[Number(row.day_of_week)]={on:Boolean(row.is_available),start:apiTime(row.start_time),end:apiTime(row.end_time)}});
  return result;
}

async function loadApiData(user){
  let [providerPayload,patientPayload,appointmentPayload,locationPayload]=await Promise.all([
    apiRequest('/providers'),apiRequest('/patients'),apiRequest('/appointments'),apiRequest('/locations')
  ]);
  let availabilityPayloads=await Promise.all(providerPayload.providers.map(provider=>apiRequest(`/providers/${provider.id}/availability`)));
  let providerIds=new Map(),patientIds=new Map();
  let providers=providerPayload.providers.map((provider,index)=>{
    let id=index+1;providerIds.set(provider.id,id);
    return {id,apiId:provider.id,name:provider.full_name,email:provider.email,mobile:provider.mobile||'',role:provider.professional_title||'Provider',duration:String(provider.default_duration_minutes||60),bio:provider.bio||'',online:Boolean(provider.is_online),active:provider.is_active!==false,locations:provider.locations||[],availability:availabilityFromApi(availabilityPayloads[index].availability||[])}
  });
  let patients=patientPayload.patients.map((patient,index)=>{
    let id=101+index;patientIds.set(patient.id,id);
    return {id,apiId:patient.id,name:patient.full_name,email:patient.email,mobile:patient.mobile||'',contact:patient.preferred_contact||'WhatsApp',active:patient.is_active!==false}
  });
  let appointments=appointmentPayload.appointments.map((appointment,index)=>({
    id:900001+index,apiId:appointment.id,providerId:providerIds.get(appointment.provider_id),patientId:patientIds.get(appointment.patient_id),date:apiDate(appointment.appointment_date),time:apiTime(appointment.appointment_time),duration:Number(appointment.duration_minutes||60),type:appointment.appointment_type,mode:appointment.mode,location:appointment.location_name||appointment.mode,status:appointment.status,payment:appointment.payment_status,note:appointment.note||'',intakeRequested:Boolean(appointment.intake_requested)
  })).filter(appointment=>appointment.providerId&&appointment.patientId);
  apiLocations=locationPayload.locations||[];
  data={admins:user.role==='admin'?[{id:user.id,name:user.fullName,email:user.email}]:[],providers,patients,appointments,messages:data.messages||[],auditLog:[]};
  if(user.role==='admin'){
    let [auditPayload,registrationPayload]=await Promise.all([apiRequest('/audit-logs'),apiRequest('/registrations')]);
    data.auditLog=(auditPayload.auditLogs||[]).map(row=>{
      let appointment=appointments.find(item=>item.apiId===row.appointment_id),patient=appointment&&patients.find(item=>item.id===appointment.patientId),provider=appointment&&providers.find(item=>item.id===appointment.providerId);
      return {id:row.id,createdAt:row.created_at,user:row.user_name,role:row.user_role,location:row.location_name||row.details?.location||'Server',action:row.action,patient:patient?.name||'Booking',provider:provider?.name||'',date:appointment?.date||apiDate(row.details?.appointmentDate),time:appointment?.time||apiTime(row.details?.appointmentTime)}
