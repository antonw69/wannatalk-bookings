  let filtered=patients.filter(patient=>!search||[patient.name,patient.email,patient.mobile].some(value=>String(value||'').toLowerCase().includes(search)));
  summary.textContent=`${activeCount} active · ${patients.length-activeCount} inactive · ${patients.length} total`;
