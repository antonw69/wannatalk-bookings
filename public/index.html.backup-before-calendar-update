async function submitRegistration(){
  let email=$('rEmail')?.value.trim(),name=$('rName')?.value.trim(),password=$('rPassword')?.value||'',locations=authRole==='provider'?[['rLocCenturion','Centurion'],['rLocEmalahleni','Emalahleni'],['rLocOnline','Online']].filter(([id])=>$(id)?.checked).map(([,location])=>location):[];
  if(!name||!email||!password)return toast('Name, email and password are required');
  if(password.length<12)return toast('Password must contain at least 12 characters');
  if(authRole==='provider'&&!locations.length)return toast('Choose at least one practice location');
  let button=$('registerForm').querySelector('button.btn');button.disabled=true;button.textContent='Submitting…';
  try{
    let payload=await apiRequest('/auth/register',{method:'POST',body:JSON.stringify({role:authRole,fullName:name,email,mobile:$('rMobile')?.value.trim(),password,preferredContact:$('rContact')?.value||'Email',professionalTitle:$('rRole')?.value.trim(),durationMinutes:Number($('rDuration')?.value||60),bio:$('rBio')?.value.trim(),locations})});
    $('rPassword').value='';
    if(payload.verificationRequired){$('rPassword').value='';showMfaChallenge(payload,email);toast('Registration created · verify your contact details');return}
    if(payload.status==='approved'&&payload.token){apiToken=payload.token;localStorage.setItem(apiTokenKey,apiToken);await loadApiData(payload.user);openSession();toast('Patient account created successfully');return}
    $('loginEmail').value=email;switchMode('login');$('demoCreds').textContent=payload.message||'Registration submitted for administrator approval.';toast('Registration submitted for approval');
  }catch(error){toast(error.message)}finally{button.disabled=false;button.textContent='Create account'}
}

function escapeAccountText(value){return String(value??'').replace(/[&<>'"]/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]))}
