<script>
const apiBase=window.WANNATALK_API_BASE||(location.protocol==='file:'?'http://127.0.0.1:3000/api':'/api');
const apiTokenKey='wannatalkApiToken';
let apiToken=localStorage.getItem(apiTokenKey)||'';
let apiLocations=[];
let passwordResetToken='';
let mfaChallenge=null;
[...(data.admins||[]),...(data.providers||[]),...(data.patients||[])].forEach(account=>delete account.password);
